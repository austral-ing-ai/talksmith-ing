
# --- Talksmith --- (regenerable build artifacts & caches — keep out of Git)
.DS_Store
.venv/
__pycache__/
*.pyc
# Ignore build artifacts under output/, but keep index.html and any images/
talks/*/output/**
!talks/*/output/**/
!talks/*/output/**/index.html
!talks/*/output/**/images/**
!talks/*/output/slide-model.json
talks/*/images/.critique/
.icons/
.claude/settings.local.json
